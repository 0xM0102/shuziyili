# 复制到服务器如 /opt/shuziyili/config/api.env（chmod 600），在 systemd EnvironmentFile= 中引用。
# 勿提交真实文件。

SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/shuziyili?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=shuziyili
SPRING_DATASOURCE_PASSWORD=请修改为强密码

# 门户 + 根域 + 管理后台（https，无尾斜杠，逗号分隔）
CORS_ALLOWED_ORIGINS=https://www.shuziyili.com,https://shuziyili.com,https://admin.shuziyili.com

# ---------------------------------------------------------------------------
# 门户资讯数据源（三选一：NEWS_PROVIDER=juhe | tianapi | tencent）
# ---------------------------------------------------------------------------
# NEWS_PROVIDER=juhe

# 方案 A：聚合数据「新闻头条」https://www.juhe.cn/docs/api/id/235
# JUHE_NEWS_ENABLED=true
# JUHE_NEWS_KEY=你的key
# JUHE_NEWS_REFRESH_SECONDS=3600

# 方案 B：天聚数行「地区新闻」https://www.tianapi.com/apiview/154
# NEWS_PROVIDER=tianapi
# TIANAPI_NEWS_ENABLED=true
# TIANAPI_NEWS_KEY=你的key
# TIANAPI_NEWS_AREANAME=新疆
# TIANAPI_NEWS_REFRESH_SECONDS=3600

# 方案 C：腾讯新闻 Skills https://news.qq.com/exchange?scene=appkey
# NEWS_PROVIDER=tencent
# TENCENT_NEWS_ENABLED=true
# TENCENT_NEWS_KEY=你的key
# TENCENT_NEWS_REFRESH_SECONDS=3600

# 可选：8080 被占用时改为 8081，并同步修改 Nginx api 的 proxy_pass
# SERVER_PORT=8080

# 生产建议关闭验证码明文存储
# SHUZIYILI_STORE_PLAIN_OTP=false

# 腾讯云 COS、短信等按运维要求追加
