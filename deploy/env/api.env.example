# 复制到服务器如 /opt/shuziyili/config/api.env（chmod 600），在 systemd EnvironmentFile= 中引用。
# 勿提交真实文件。
#
# 门户默认栈（本地 / 开发 / 生产统一）：
#   主资讯  → 聚合「新闻头条」235（NEWS_PROVIDER=juhe）
#   天气    → 聚合「天气预报」73（WEATHER_PROVIDER=juhe）
#   首页新疆资讯 → 天聚「地区新闻」154（TIANAPI_NEWS_*，与主资讯解耦）
# 同一 Juhe AppKey 可复用，但须在控制台分别开通 235 与 73。

SPRING_PROFILES_ACTIVE=prod

SPRING_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/shuziyili?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
SPRING_DATASOURCE_USERNAME=shuziyili
SPRING_DATASOURCE_PASSWORD=请修改为强密码

# 门户 + 根域 + 管理后台（https，无尾斜杠，逗号分隔）
CORS_ALLOWED_ORIGINS=https://www.shuziyili.com,https://shuziyili.com,https://admin.shuziyili.com

# ---------------------------------------------------------------------------
# 门户资讯 + 天气（默认聚合 Juhe）
# ---------------------------------------------------------------------------
NEWS_PROVIDER=juhe
WEATHER_PROVIDER=juhe

# 聚合「新闻头条」https://www.juhe.cn/docs/api/id/235
JUHE_NEWS_ENABLED=true
JUHE_NEWS_KEY=你的JuheAppKey
JUHE_NEWS_TYPE=top
JUHE_NEWS_REFRESH_SECONDS=3600

# 聚合「天气预报」https://www.juhe.cn/docs/api/id/73
JUHE_WEATHER_ENABLED=true
# JUHE_WEATHER_KEY=可与 JUHE_NEWS_KEY 相同；留空则自动共用 JUHE_NEWS_KEY
JUHE_WEATHER_DEFAULT_ADCODE=654002
JUHE_WEATHER_REFRESH_SECONDS=600

# 首页「新疆资讯」块（天聚地区新闻，与 NEWS_PROVIDER 无关）
# https://www.tianapi.com/apiview/154
TIANAPI_NEWS_ENABLED=true
TIANAPI_NEWS_KEY=你的TianAPIKey
TIANAPI_NEWS_AREANAME=新疆
TIANAPI_NEWS_REFRESH_SECONDS=3600

# ---------------------------------------------------------------------------
# 备选：腾讯新闻 + 腾讯天气（不用时保持注释或 enabled=false）
# ---------------------------------------------------------------------------
# NEWS_PROVIDER=tencent
# WEATHER_PROVIDER=tencent
# TENCENT_NEWS_ENABLED=true
# TENCENT_NEWS_KEY=你的key
# TENCENT_WEATHER_ENABLED=true

# 可选：8080 被占用时改为 8081，并同步修改 Nginx api 的 proxy_pass
# SERVER_PORT=8080

# 生产建议关闭验证码明文存储
# SHUZIYILI_STORE_PLAIN_OTP=false

# 腾讯云 COS、短信等按运维要求追加
