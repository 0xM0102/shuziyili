[Unit]
Description=Shuziyili Web (Next.js)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/shuziyili/web

# 若使用 .env.production.local，确保文件存在且权限正确；或在此处 Environment= 逐项列出
ExecStart=/usr/bin/npm run start -- --hostname 127.0.0.1 --port 3000

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
