# 复制为 /etc/nginx/conf.d/api.shuziyili.com.conf
# 将 8081 改为你机上 shuziyili-api 实际端口（ss -tlnp | grep java）。
#
# 证书（必读）：此处 `ssl_certificate` 必须对 **`api.shuziyili.com` 有效**
#（证书 SAN 含该名，或通配符 `*.shuziyili.com`）。
# 若你当前只有「主域 + www」证书，浏览器会报 **ERR_CERT_COMMON_NAME_INVALID**。
# 处理方式二选一：
#   ① 在腾讯云申请 **含 api** 的多域名证书或 **\*.shuziyili.com**，再部署到本路径；或
#   ② 不要用本子域，改用主域路径反代：见 **snippet-portal-443-location-api.conf.example**，
#      并把前端 `VITE_API_BASE_URL` / `NEXT_PUBLIC_API_BASE_URL` 设为 `https://shuziyili.com`。

server {
    listen 80;
    server_name api.shuziyili.com;
    return 301 https://api.shuziyili.com$request_uri;
}

server {
    listen 443 ssl;
    server_name api.shuziyili.com;

    ssl_certificate     /etc/nginx/ssl/shuziyili/shuziyili.com_bundle.crt;
    ssl_certificate_key /etc/nginx/ssl/shuziyili/shuziyili.com.key;

    client_max_body_size 20m;

    location / {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
