# -----------------------------------------------------------------------------
# 本地覆盖配置（密钥、数据库密码等只放本机，勿提交）
#
# 用法：
#   1) cp application-local.yml.example application-local.yml
#   2) 编辑 application-local.yml（已在 .gitignore）
#   3) ./mvnw spring-boot:run   # 默认 profile：dev + local
#
# 与 deploy/env/api.env.example 同一套默认栈：
#   主资讯 Juhe 235 | 天气 Juhe 73 | 首页新疆资讯 TianAPI 154
# -----------------------------------------------------------------------------

shuziyili:
  cos:
    enabled: true
    secret-id: "在此填写 SecretId"
    secret-key: "在此填写 SecretKey"

  news:
    provider: juhe

  weather:
    provider: juhe

  juhe:
    news:
      enabled: true
      key: "在此填写 JUHE_NEWS_KEY"
      type: top
      refresh-seconds: 3600
    weather:
      enabled: true
      # key 可省略，与 news 共用 JUHE_NEWS_KEY
      default-adcode: 654002
      refresh-seconds: 600

  tianapi:
    news:
      enabled: true
      key: "在此填写 TIANAPI_NEWS_KEY"
      areaname: 新疆
      refresh-seconds: 3600

  tencent:
    news:
      enabled: false
    weather:
      enabled: false

# spring:
#   datasource:
#     password: your_password
