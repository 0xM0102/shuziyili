# 生产环境可省略（默认 https://shuziyili.com，见 lib/site.ts）
# 本地若需与线上不同的 canonical / OG，可改为 http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://shuziyili.com

# 后端 API 根地址。可只写主机，如 http://localhost:8080，会自动补全为 /api/v1
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# 本地开发建议复制为 .env.local 并启用：
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
