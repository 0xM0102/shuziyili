.DS_Store

# Next.js（web）
web/node_modules/
web/.next/
web/out/

# Java（api）
api/target/
api/data/
api/.idea/
*.iml

# 环境变量（勿提交密钥）
.env
.env.local
.env*.local
web/.env.local

# Vue 管理后台（生产环境变量，勿提交）
admin/node_modules/
admin/dist/
admin/.env.production.local

# 本地数据库配置（复制自 application-local.yml.example）
api/src/main/resources/application-local.yml

# API 本地启动脚本（可含 export 密钥）
api/scripts/run-dev-with-cos.sh

# 根目录本地一键启动脚本（可含 export 密钥）
scripts/dev.sh

# 日志与调试
npm-debug.log*
*.pem
*.key
# TLS 证书（勿提交；私钥见 *.key）
api/docs/*.crt

# TypeScript（根目录若再有 TS 工具）
*.tsbuildinfo
